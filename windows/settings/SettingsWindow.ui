<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SettingsWindow</class>
 <widget class="QDialog" name="SettingsWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>460</width><height>520</height></rect></property>
  <property name="windowTitle"><string>Paramètres ToonTrad</string></property>
  <layout class="QVBoxLayout" name="mainLayout">

   <!-- OCR -->
   <item>
    <widget class="QGroupBox" name="groupOCR">
     <property name="title"><string>Paramètres OCR</string></property>
     <layout class="QFormLayout">

      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Confiance min. :</string></property></widget></item>
      <item row="0" column="1">
       <layout class="QHBoxLayout">
        <item><widget class="QSlider" name="sliderConfidence"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>10</number></property><property name="maximum"><number>100</number></property><property name="value"><number>40</number></property></widget></item>
        <item><widget class="QLabel" name="lblConfValue"><property name="text"><string>40%</string></property><property name="minimumWidth"><number>35</number></property></widget></item>
       </layout>
      </item>

      <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Surface min. bulle :</string></property></widget></item>
      <item row="1" column="1"><widget class="QSpinBox" name="spinMinArea"><property name="minimum"><number>100</number></property><property name="maximum"><number>50000</number></property><property name="singleStep"><number>500</number></property><property name="value"><number>2000</number></property></widget></item>

      <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Langue source :</string></property></widget></item>
      <item row="2" column="1"><widget class="QComboBox" name="comboLanguage"/></item>

      <item row="3" column="0"><widget class="QLabel"><property name="text"><string>PSM Tesseract :</string></property></widget></item>
      <item row="3" column="1">
       <widget class="QComboBox" name="comboPSM">
        <item><property name="text"><string>3 — Automatique</string></property></item>
        <item><property name="text"><string>6 — Bloc de texte uniforme</string></property></item>
        <item><property name="text"><string>11 — Texte épars</string></property></item>
        <item><property name="text"><string>13 — Ligne unique</string></property></item>
       </widget>
      </item>

      <item row="4" column="0"><widget class="QLabel"><property name="text"><string>Ratio inner rect :</string></property></widget></item>
      <item row="4" column="1">
       <layout class="QHBoxLayout">
        <item><widget class="QSlider" name="sliderInnerRatio"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>50</number></property><property name="maximum"><number>100</number></property><property name="value"><number>85</number></property></widget></item>
        <item><widget class="QLabel" name="lblInnerRatio"><property name="text"><string>85%</string></property><property name="minimumWidth"><number>35</number></property></widget></item>
       </layout>
      </item>

     </layout>
    </widget>
   </item>

   <!-- Ressources GPU/RAM -->
   <item>
    <widget class="QGroupBox" name="groupResources">
     <property name="title"><string>Ressources</string></property>
     <layout class="QFormLayout">

      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>VRAM GPU :</string></property></widget></item>
      <item row="0" column="1">
       <layout class="QHBoxLayout">
        <item><widget class="QSlider" name="sliderVRAM"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>10</number></property><property name="maximum"><number>100</number></property><property name="value"><number>50</number></property></widget></item>
        <item><widget class="QLabel" name="lblVRAMVal"><property name="text"><string>50%</string></property></widget></item>
       </layout>
      </item>

      <item row="1" column="0"><widget class="QLabel"><property name="text"><string>RAM CPU :</string></property></widget></item>
      <item row="1" column="1">
       <layout class="QHBoxLayout">
        <item><widget class="QSlider" name="sliderRAM"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>1</number></property><property name="maximum"><number>64</number></property><property name="value"><number>4</number></property></widget></item>
        <item><widget class="QLabel" name="lblRAMVal"><property name="text"><string>4 GB</string></property></widget></item>
       </layout>
      </item>

     </layout>
    </widget>
   </item>

   <!-- Python -->
   <item>
    <widget class="QGroupBox" name="groupPython">
     <property name="title"><string>Chemins Python</string></property>
     <layout class="QFormLayout">

      <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Exécutable :</string></property></widget></item>
      <item row="0" column="1">
       <layout class="QHBoxLayout">
        <item><widget class="QLineEdit" name="editPythonBin"/></item>
        <item><widget class="QPushButton" name="btnBrowsePython"><property name="text"><string>...</string></property><property name="maximumWidth"><number>30</number></property></widget></item>
       </layout>
      </item>

      <item row="1" column="0"><widget class="QLabel"><property name="text"><string>detect.py :</string></property></widget></item>
      <item row="1" column="1">
       <layout class="QHBoxLayout">
        <item><widget class="QLineEdit" name="editDetectScript"/></item>
        <item><widget class="QPushButton" name="btnBrowseScript"><property name="text"><string>...</string></property><property name="maximumWidth"><number>30</number></property></widget></item>
       </layout>
      </item>

      <item row="2" column="0" colspan="2">
       <widget class="QPushButton" name="btnTestPython"><property name="text"><string>Tester la connexion Python</string></property></widget>
      </item>

     </layout>
    </widget>
   </item>

   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons"><set>QDialogButtonBox::Ok|QDialogButtonBox::Cancel</set></property>
    </widget>
   </item>

  </layout>
 </widget>
</ui>
