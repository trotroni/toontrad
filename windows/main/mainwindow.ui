<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1400</width><height>900</height></rect>
  </property>
  <property name="windowTitle">
   <string>ToonTrad</string>
  </property>

  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="rootLayout">

    <!-- ══ CANVAS GAUCHE (scrollable) ══ -->
    <item>
     <widget class="QScrollArea" name="imageScroll">
      <property name="widgetResizable"><bool>true</bool></property>
      <property name="sizePolicy">
       <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
        <horstretch>2</horstretch>
       </sizepolicy>
      </property>
      <!-- ImageCanvas promu via Qt Designer -->
      <widget class="QWidget" name="canvasContainer"/>
     </widget>
    </item>

    <!-- ══ PANNEAU DROIT ══ -->
    <item>
     <widget class="QFrame" name="rightPanel">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
        <horstretch>1</horstretch>
       </sizepolicy>
      </property>
      <property name="minimumWidth"><number>340</number></property>
      <property name="maximumWidth"><number>420</number></property>
      <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>

      <layout class="QVBoxLayout" name="rightLayout">

       <!-- Nom image courante -->
       <item>
        <widget class="QLabel" name="lblImageName">
         <property name="text"><string>—</string></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
         <property name="styleSheet">
          <string>font-weight: bold; padding: 4px;</string>
         </property>
        </widget>
       </item>

       <!-- Scroll bulles -->
       <item>
        <widget class="QScrollArea" name="bubblesScroll">
         <property name="widgetResizable"><bool>true</bool></property>
         <widget class="QWidget" name="bubblesContent">
          <layout class="QVBoxLayout" name="bubblesLayout">
           <item>
            <spacer>
             <property name="orientation"><enum>Qt::Vertical</enum></property>
            </spacer>
           </item>
          </layout>
         </widget>
        </widget>
       </item>

       <!-- Boutons navigation + actions -->
       <item>
        <layout class="QHBoxLayout">
         <item><widget class="QPushButton" name="btnPrev"><property name="text"><string>⬅ Précédent</string></property></widget></item>
         <item><widget class="QPushButton" name="btnNext"><property name="text"><string>Suivant ➡</string></property></widget></item>
        </layout>
       </item>

       <item>
        <layout class="QHBoxLayout">
         <item><widget class="QPushButton" name="btnOpenFolder"><property name="text"><string>📂 Ouvrir dossier</string></property></widget></item>
         <item><widget class="QPushButton" name="btnSave"><property name="text"><string>💾 Sauvegarder</string></property></widget></item>
        </layout>
       </item>

       <item>
        <layout class="QHBoxLayout">
         <item><widget class="QPushButton" name="btnAdd"><property name="text"><string>➕ Ajouter bulle</string></property></widget></item>
         <item><widget class="QPushButton" name="btnReloadConfig"><property name="text"><string>🔄 Recharger config</string></property></widget></item>
        </layout>
       </item>

       <!-- Console log -->
       <item>
        <widget class="QTextBrowser" name="console">
         <property name="fixedHeight"><number>100</number></property>
        </widget>
       </item>

      </layout>
     </widget>
    </item>

   </layout>
  </widget>

  <widget class="QStatusBar" name="statusbar"/>
 </widget>
</ui>
