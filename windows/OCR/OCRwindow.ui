<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>OCRwindow</class>
 <widget class="QMainWindow" name="OCRwindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1280</width><height>820</height></rect></property>
  <property name="windowTitle"><string>ToonTrad — OCR</string></property>

  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="rootLayout">

    <!-- ══ BARRE DE NAVIGATION ══ -->
    <item>
     <widget class="QFrame" name="navBar">
      <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
      <layout class="QHBoxLayout" name="navLayout">

       <item><widget class="QPushButton" name="btnPrev"><property name="text"><string>◀ Précédent</string></property></widget></item>
       <item><widget class="QLabel" name="lblPage"><property name="text"><string>Page — / —</string></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
       <item><widget class="QPushButton" name="btnNext"><property name="text"><string>Suivant ▶</string></property></widget></item>

       <item><widget class="QFrame"><property name="frameShape"><enum>QFrame::VLine</enum></property></widget></item>

       <item>
        <widget class="QPushButton" name="btnRunOCR">
         <property name="text"><string>▶ Lancer l'OCR</string></property>
         <property name="styleSheet"><string>font-weight: bold;</string></property>
        </widget>
       </item>

       <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>

       <item><widget class="QPushButton" name="btnSave"><property name="text"><string>💾 Sauvegarder</string></property></widget></item>
       <item><widget class="QPushButton" name="btnExportJSON"><property name="text"><string>JSON</string></property></widget></item>
       <item><widget class="QPushButton" name="btnExportPNG"><property name="text"><string>PNG</string></property></widget></item>
       <item><widget name="btnExportTXT" class="QPushButton"><property name="text"><string>TXT</string></property></widget></item>

      </layout>
     </widget>
    </item>

    <!-- ══ CONTENU PRINCIPAL ══ -->
    <item>
     <layout class="QHBoxLayout" name="contentLayout">

      <!-- IMAGE -->
      <item>
       <widget class="QFrame" name="imageFrame">
        <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
        <layout class="QVBoxLayout">
         <item>
          <!-- ImageCanvas est un widget custom — ajouté via promoted widget -->
          <widget class="QGraphicsView" name="imageCanvas">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Expanding"/>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>

      <!-- PANNEAU OCR -->
      <item>
       <widget class="QFrame" name="ocrFrame">
        <property name="minimumWidth"><number>340</number></property>
        <property name="maximumWidth"><number>400</number></property>
        <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
        <layout class="QVBoxLayout">

         <item>
          <widget class="QLabel" name="lblOCRPanel">
           <property name="text"><string>BLOCS OCR</string></property>
           <property name="styleSheet"><string>font-weight: bold; font-size: 12px; padding: 4px;</string></property>
          </widget>
         </item>

         <item>
          <widget class="QScrollArea" name="ocrScroll">
           <property name="widgetResizable"><bool>true</bool></property>
           <widget class="QWidget" name="ocrContent">
            <layout class="QVBoxLayout" name="ocrLayout">
             <!-- Blocs ajoutés dynamiquement ici -->
             <item>
              <spacer name="ocrSpacer">
               <property name="orientation"><enum>Qt::Vertical</enum></property>
              </spacer>
             </item>
            </layout>
           </widget>
          </widget>
         </item>

        </layout>
       </widget>
      </item>

     </layout>
    </item>

    <!-- ══ STATUS BAR ══ -->
    <item>
     <widget class="QLabel" name="lblStatus">
      <property name="text"><string>Prêt</string></property>
      <property name="styleSheet"><string>color: #888; padding: 2px 6px;</string></property>
     </widget>
    </item>

   </layout>
  </widget>
 </widget>
</ui>
